# CodeSpeed Server Environment Configuration Template
# Copy this file to .env and provide your actual production credentials

# Server Port (default: 5000)
PORT=5000

# Node Environment ('production', 'development', 'test')
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas or self-hosted)
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/codespeed?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/codespeed

# Secret key for JWT signing & verification (generate a strong 64-char random string in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production

# Frontend Client URL(s) for CORS allowlist (comma-separated if multiple domains)
# Example: https://codespeed.vercel.app,https://codespeed.app
CLIENT_URL=http://localhost:5173
